    },
    "The Mac sent more than expected." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 傳來的資料超出預期。"
          }
        }
      }
    },
    "This Device" : {
      "comment" : "Localized in English on purpose: Xcode makes en.lproj only when English has a string of its own, and the App Store lists only languages with an .lproj (QA1828).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Device"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台裝置"
          }
        }
      }
    },
    "Time" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間"
          }
        }
      }
    },
    "Time window" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間範圍"
          }
        }
      }
    },
    "Timed once a second over Wi-Fi. Jitter is how much back-to-back round trips differ, which is what calls and games feel." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 Wi-Fi 每秒量測一次。抖動是相鄰兩次往返時間的差異，也就是通話與遊戲感受到的不穩定。"
          }
        }
      }
    },
    "Tx rate" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳輸速率"
          }
        }
      }
    },
