      "shouldTranslate" : false
    },
    "Wi-Fi is off" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi 已關閉"
          }
        }
      }
    },
    "WiFiDetect needs it to find your Mac." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WiFiDetect 需要它才能找到你的 Mac。"
          }
        }
      }
    },
    "iOS doesn't let apps read Wi-Fi signal strength. Link quality is the system's own rating of this connection." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 不允許 App 讀取 Wi-Fi 訊號強度。連結品質是系統自己對此連線的評等。"
          }
        }
      }
    },
    "iOS shows the network's name only to apps with location access. WiFiDetect doesn't use where you are." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 只會向有定位權限的 App 顯示網路名稱。WiFiDetect 不會使用你的所在位置。"
          }
        }
      }
    },
    "—" : {
      "shouldTranslate" : false
