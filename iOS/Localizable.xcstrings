    "Show Name" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示名稱"
          }
        }
      }
    },
    "Shows the signal chart of a Mac running WiFiDetect on this network. iOS will ask to let WiFiDetect find devices on your local network." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示此網路上正在執行 WiFiDetect 的 Mac 的訊號圖表。iOS 會詢問是否允許 WiFiDetect 尋找區域網路上的裝置。"
          }
        }
      }
    },
    "Signal" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊號"
          }
        }
      }
    },
    "Signal and noise (dBm)" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊號與雜訊（dBm）"
