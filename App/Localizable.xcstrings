    "Response script failed, so the response went on as it came: %@" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回應腳本執行失敗，因此回應照原樣送出：%@"
          }
        }
      }
    },
    "Response script not run: its body is over 10 MB." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未執行回應腳本：內文超過 10 MB。"
          }
        }
      }
    },
    "Response script ran in %@." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回應腳本執行耗時 %@。"
          }
        }
      }
    },
    "Restart the Mac to finish installing it" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新啟動 Mac 以完成安裝"
          }
        }
      }
    },
    "Restart the Mac to finish removing it" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新啟動 Mac 以完成移除"
          }
        }
      }
    },
    "Restore Defaults" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復預設值"
          }
        }
      }
    },
    "Roaming line" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "漫遊線"
          }
        }
      }
    },
    "Round trip of the TCP handshake, timed at %@: its SYN to the SYN-ACK when it opened the connection, its SYN-ACK to the ACK when the other end did. “—” when the capture missed the handshake, and for anything but TCP." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TCP 交握的往返時間，量測位置：%@。本端開啟連線時為 SYN 到 SYN-ACK，對方開啟時為 SYN-ACK 到 ACK。擷取時錯過交握，或不是 TCP 時，顯示「—」。"
          }
        }
      }
    },
    "Router Flows" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路由器流量"
          }
        }
      }
    },
    "Router flows" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路由器流量"
          }
        }
      }
    },
    "Rules" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "規則"
          }
        }
      }
    },
    "Runs as root, only to read packets for traffic monitoring and to point the system proxy at WiFiDetect. It starts when WiFiDetect connects to it and quits when WiFiDetect does, putting the proxy settings back." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 root 身分執行，只用來為流量監控讀取封包，以及將系統代理伺服器指向 WiFiDetect。它在 WiFiDetect 連線時啟動，並隨 WiFiDetect 一起結束，同時還原代理伺服器設定。"
          }
        }
      }
    },
    "SNR" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊雜比"
          }
        }
      }
    },
    "Sampling rate" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取樣頻率"
          }
        }
      }
    },
    "Save" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存"
          }
        }
      }
    },
    "Saved %@ packets to %@" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已將 %1$@ 個封包儲存到 %2$@"
          }
        }
      }
    },
    "Scan" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描"
          }
        }
      }
    },
    "Scan Failed" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描失敗"
          }
        }
      }
    },
    "Scan again on an interval while this page is open" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此頁面開啟時定期重新掃描"
          }
        }
      }
    },
    "Scanning…" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在掃描⋯"
          }
        }
      }
    },
    "Script" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳本"
          }
        }
      }
    },
    "Scripts" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳本"
          }
        }
      }
    },
    "Security" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全性"
          }
        }
      }
    },
    "Seeing traffic means reading packets, which macOS allows only as root. WiFiDetect installs a small helper that does just that, and nothing else." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要看到流量就得讀取封包，而 macOS 只允許 root 這麼做。WiFiDetect 會安裝一個小型輔助程式，只做這件事，不做其他事。"
          }
        }
      }
    },
    "Send to" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送至"
          }
        }
      }
    },
    "Sending this Mac's web traffic through the proxy means changing its network settings, which macOS allows only as root. WiFiDetect installs a small helper that does that, and puts them back when WiFiDetect quits." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要讓這台 Mac 的網頁流量經過代理伺服器，就得更改它的網路設定，而 macOS 只允許 root 這麼做。WiFiDetect 會安裝一個小型輔助程式來處理，並在 WiFiDetect 結束時還原設定。"
          }
        }
      }
    },
    "Sent" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已傳送"
          }
        }
      }
    },
    "Series" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "數列"
          }
        }
      }
    },
    "Service" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服務"
          }
        }
      }
    },
    "Services" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服務"
          }
        }
      }
    },
    "Share readings with iPhone and iPad" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與 iPhone 和 iPad 分享讀數"
          }
        }
      }
    },
    "Show" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示"
          }
        }
      }
    },
    "Show Network Names" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示網路名稱"
          }
        }
      }
    },
    "Show all" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示全部"
          }
        }
      }
    },
    "Show in Finder" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Finder 中顯示"
          }
        }
      }
    },
    "Show in menu bar" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選單列中顯示"
          }
        }
      }
    },
    "Show less" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示較少"
          }
        }
      }
    },
    "Showing %@" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在顯示 %@"
          }
        }
      }
    },
    "Shown decoded. Edited, it goes on unencoded." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以解碼後的內容顯示。編輯後會以未編碼的形式送出。"
          }
        }
      }
    },
    "Signal" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊號"
          }
        }
      }
    },
    "Signal and noise (dBm)" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊號與雜訊（dBm）"
          }
        }
      }
    },
    "Signal grades" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊號等級"
          }
        }
      }
    },
    "Signal-to-noise ratio" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊雜比"
          }
        }
      }
    },
    "Signal-to-noise ratio (dB)" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊雜比（dB）"
          }
        }
      }
    },
    "Size" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大小"
          }
        }
      }
    },
    "Slows everything through the proxy as a poor network would: downloads and uploads to these rates, shared by all connections, 0 for no limit; and every round trip by the latency, half each way. The presets are Chrome DevTools'. Packets aren't dropped, and Map Local answers come back at full speed." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像不佳的網路一樣，減慢所有經過代理伺服器的流量：下載與上傳限制在這些速率（所有連線共用，0 表示不限制），每次往返再加上延遲（去回各一半）。預設組合取自 Chrome DevTools。封包不會被丟棄，Map Local 的回應會以全速傳回。"
          }
        }
      }
    },
    "Source" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來源"
          }
        }
      }
    },
    "Star a connection in Connections to add its host: its domain, or its address when it has none." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「連線」中為連線加上星號，即可加入它的主機：網域，沒有網域時則為位址。"
          }
        }
      }
    },
    "Start Capture" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始擷取"
          }
        }
      }
    },
    "Start Proxy" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟動代理伺服器"
          }
        }
      }
    },
    "Start the proxy to send this Mac's web traffic through WiFiDetect." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟動代理伺服器，讓這台 Mac 的網頁流量經過 WiFiDetect。"
          }
        }
      }
    },
    "Started" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始時間"
          }
        }
      }
    },
    "Starting to capture %@…" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在開始擷取 %@⋯"
          }
        }
      }
    },
    "Status" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "狀態"
          }
        }
      }
    },
    "Stop Capture" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止擷取"
          }
        }
      }
    },
    "Stop Proxy" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止代理伺服器"
          }
        }
      }
    },
    "Stop Recording" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止錄製"
          }
        }
      }
    },
    "Text" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字"
          }
        }
      }
    },
    "The CA certificate is malformed" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CA 憑證格式不正確"
          }
        }
      }
    },
    "The Mac sent more than expected." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 傳來的資料超出預期。"
          }
        }
      }
    },
    "The WiFiDetect app on an iPhone or iPad on the same network can then show this Mac's signal chart. So can anyone else on the network: signal, noise, channel and tx rate, never the network's name." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如此一來，同一網路上 iPhone 或 iPad 的 WiFiDetect App 就能顯示這台 Mac 的訊號圖表。網路上的其他人也能看到：訊號、雜訊、頻道與傳輸速率，絕不包含網路名稱。"
          }
        }
      }
    },
    "The body is text, or null to send it as it came." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "body 必須是文字，或用 null 表示照原樣送出。"
          }
        }
      }
    },
    "The client cancelled the request." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用戶端取消了請求。"
          }
        }
      }
    },
    "The client closed the connection." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用戶端關閉了連線。"
          }
        }
      }
    },
    "The flow collector is off." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流量收集器已關閉。"
          }
        }
      }
    },
    "The helper didn't answer within 10 seconds, so macOS probably can't start it, as happens after switching to another build of WiFiDetect. In Settings › Helper, uninstall it and install it again. If it still doesn't answer, restart the Mac." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輔助程式在 10 秒內沒有回應，macOS 可能無法啟動它，換成另一個 WiFiDetect 版本後常會這樣。請在「設定 › 輔助程式」中將它解除安裝後重新安裝。若仍沒有回應，請重新啟動 Mac。"
          }
        }
      }
    },
    "The helper stopped unexpectedly and couldn't put the proxy settings back: %@ Check System Settings › Network › Proxies." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輔助程式意外停止，且無法還原代理伺服器設定：%@ 請檢查「系統設定 › 網路 › 代理伺服器」。"
          }
        }
      }
    },
    "The helper stopped unexpectedly, so the proxy is off. Start it again." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輔助程式意外停止，代理伺服器已關閉。請重新啟動。"
          }
        }
      }
    },
    "The helper stopped unexpectedly. Start the capture again." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輔助程式意外停止。請重新開始擷取。"
          }
        }
      }
    },
    "The method can't be empty or have spaces." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方法不能是空的，也不能包含空格。"
          }
        }
      }
    },
    "The method is text without spaces." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "method 必須是不含空格的文字。"
          }
        }
      }
    },
    "The oldest %@ messages weren't kept." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最舊的 %@ 則訊息沒有保留。"
          }
        }
      }
    },
    "The path is text that starts with / and has no spaces." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "path 必須是以 / 開頭、不含空格的文字。"
          }
        }
      }
    },
    "The path starts with / and has no spaces." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路徑必須以 / 開頭，且不能包含空格。"
          }
        }
      }
    },
    "The proxy couldn't load the system's root certificates: %@" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理伺服器無法載入系統的根憑證：%@"
          }
        }
      }
    },
    "The script has no onRequest function, so the request went on as it came." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳本沒有 onRequest 函式，因此請求照原樣送出。"
          }
        }
      }
    },
    "The script has no onResponse function, so the response went on as it came." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳本沒有 onResponse 函式，因此回應照原樣送出。"
          }
        }
      }
    },
    "The server closed the connection before the response ended." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器在回應結束前關閉了連線。"
          }
        }
      }
    },
    "The server closed the connection during the TLS handshake." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器在 TLS 交握期間關閉了連線。"
          }
        }
      }
    },
    "The server didn't answer within %lld seconds." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器在 %lld 秒內沒有回應。"
          }
        }
      }
    },
    "The status is a number from 100 to 599." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "狀態碼必須是 100 到 599 之間的數字。"
